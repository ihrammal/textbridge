<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.17763.0</TargetFramework><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>TextBridge</AssemblyName>
    <Version>1.1.0</Version><AssemblyVersion>1.1.0.1</AssemblyVersion><FileVersion>1.1.0.1</FileVersion><RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion><Authors>Iman Rammal</Authors><Product>TextBridge</Product>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Resources\ar.json" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="AccessibleOCRStudio.SmokeTests" /></ItemGroup>
  <ItemGroup><PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.32" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" /></ItemGroup>
  <ItemGroup>
    <Content Include="..\..\runtime\pdf\**\*" Link="pdf\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\image\**\*" Link="image\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\licenses\poppler\**\*" Link="licenses\poppler\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\licenses\imagemagick\**\*" Link="licenses\imagemagick\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resources\native-notices\**\*" Link="licenses\native\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="licenses\TextBridge-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\THIRD-PARTY-NOTICES.txt" Link="licenses\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\help\**\*" Link="help\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resources\sounds\*.wav" Link="resources\sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep the Windows API reference pack independent of the .NET servicing version. -->
  <ItemGroup><FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="10.0.17763.56" /></ItemGroup>
  <Target Name="CopyPaddleBuild" AfterTargets="Build" Condition="Exists('..\..\runtime\paddle\python\python.exe')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\copy-paddle-runtime.ps1&quot; -Destination &quot;$(TargetDir)paddle&quot;" />
  </Target>
  <Target Name="CopyPaddlePublish" AfterTargets="Publish">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\copy-paddle-runtime.ps1&quot; -Destination &quot;$(PublishDir)paddle&quot;" />
  </Target>
</Project>




